<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Authors>Pavel Zaytsev</Authors>
    <Company>Iberis Software</Company>
    <Product>ScanBot</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Version>2.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CloudKey.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- CloudKey.json is a Google service-account secret, gitignored and not present in a fresh
         checkout - only copy it when a developer has placed one locally, so CI/clean clones still build. -->
    <Content Include="CloudKey.json" Condition="Exists('CloudKey.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.9.0.5494" />
    <PackageReference Include="Google.Cloud.Vision.V1" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanBot.Data\ScanBot.Data.csproj" />
  </ItemGroup>

</Project>
