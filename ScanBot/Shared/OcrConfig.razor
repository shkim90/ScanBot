@inject Settings Settings

<Validations @ref="validations" Mode="ValidationMode.Manual">
    <Field>
        <FieldLabel>Host:</FieldLabel>
        <Validation Validator="ValidationExtention.IsTrimmedNotEmpty">
            <TextEdit @bind-Text="host" />
        </Validation>
    </Field>
    <Field>
        <FieldLabel>Text Confidence:</FieldLabel>
        <NumericEdit @bind-Value="confidence" Min="0" Max="1" Step="0.01m" />
    </Field>
    <Field>
        <Check @bind-Checked="recognizeOrientation">Recognize Orientation</Check>
    </Field>
    <Field>
        <FieldLabel>Merge X Distance:</FieldLabel>
        <NumericEdit @bind-Value="mergeXDistance" Min="0" Max="20" />
        <FieldHelp>mm - horizontal gap bridged within the same line</FieldHelp>
    </Field>
    <Field>
        <FieldLabel>Merge Y Distance:</FieldLabel>
        <NumericEdit @bind-Value="mergeYDistance" Min="0" Max="20" />
        <FieldHelp>mm - vertical tolerance for "same line"</FieldHelp>
    </Field>
</Validations>
